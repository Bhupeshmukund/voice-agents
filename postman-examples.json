{
  "description": "Example JSON data for testing Restaurant Orders API in Postman",
  "examples": {
    "create_order": {
      "method": "POST",
      "url": "http://localhost:3000/api/restaurant-orders",
      "body": {
        "name": "John Doe",
        "order_items": [
          {
            "item": "Margherita Pizza",
            "quantity": 2,
            "price": 12.99,
            "notes": "Extra cheese"
          },
          {
            "item": "Caesar Salad",
            "quantity": 1,
            "price": 8.99
          },
          {
            "item": "Coca Cola",
            "quantity": 2,
            "price": 2.50
          }
        ],
        "address": "123 Main Street, New York, NY 10001",
        "phone_no": "+1-555-123-4567",
        "amount": 39.97,
        "collection": "delivery",
        "status": "pending"
      }
    },
    "create_order_pickup": {
      "method": "POST",
      "url": "http://localhost:3000/api/restaurant-orders",
      "body": {
        "name": "Jane Smith",
        "order_items": [
          {
            "item": "Chicken Burger",
            "quantity": 1,
            "price": 9.99
          },
          {
            "item": "French Fries",
            "quantity": 1,
            "price": 4.99
          }
        ],
        "address": "456 Oak Avenue, Los Angeles, CA 90001",
        "phone_no": "+1-555-987-6543",
        "amount": 14.98,
        "collection": "pickup",
        "status": "pending"
      }
    },
    "create_order_minimal": {
      "method": "POST",
      "url": "http://localhost:3000/api/restaurant-orders",
      "body": {
        "name": "Bob Johnson",
        "order_items": [
          {
            "item": "Pasta Carbonara",
            "quantity": 1,
            "price": 15.99
          }
        ],
        "address": "789 Pine Road, Chicago, IL 60601",
        "phone_no": "555-456-7890",
        "amount": 15.99,
        "collection": "delivery"
      }
    },
    "update_order_status": {
      "method": "PATCH",
      "url": "http://localhost:3000/api/restaurant-orders/{orderId}/status",
      "note": "Replace {orderId} with actual MongoDB ObjectId from created order",
      "body": {
        "status": "processing"
      }
    },
    "update_order": {
      "method": "PATCH",
      "url": "http://localhost:3000/api/restaurant-orders/{orderId}",
      "note": "Replace {orderId} with actual MongoDB ObjectId from created order",
      "body": {
        "name": "John Doe Updated",
        "amount": 45.00,
        "status": "ready"
      }
    }
  },
  "endpoints": {
    "get_all_orders": {
      "method": "GET",
      "url": "http://localhost:3000/api/restaurant-orders"
    },
    "get_single_order": {
      "method": "GET",
      "url": "http://localhost:3000/api/restaurant-orders/{orderId}",
      "note": "Replace {orderId} with actual MongoDB ObjectId"
    },
    "delete_order": {
      "method": "DELETE",
      "url": "http://localhost:3000/api/restaurant-orders/{orderId}",
      "note": "Replace {orderId} with actual MongoDB ObjectId"
    }
  }
}
