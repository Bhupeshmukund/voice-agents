# MongoDB Connection String
# Replace with your MongoDB Atlas cluster connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database-name?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/restaurant-orders?retryWrites=true&w=majority

# Server Port (optional, defaults to 3000)
PORT=3000
